          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', () => {\r\n  pm.response.to.have.status(400);\r\n});\r\n\r\npm.test('Identifies the invalid status parameter', () => {\r\n  const body = pm.response.json();\r\n\r\n  pm.expect(body.error.code).to.equal('INVALID_QUERY_PARAMETER');\r\n  pm.expect(body.error.parameter).to.equal('status');\r\n  pm.expect(body.error.message).to.be.a('string').and.not.be.empty;\r\n});"
            ]
          }
        }
      ],
