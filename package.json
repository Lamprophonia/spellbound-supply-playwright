{
  "name": "spellbound-supply-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright Test and TypeScript automation portfolio for Spellbound Supply.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "test:postman": "postman collection run postman/collections/spellbound-catalog-api.postman_collection.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "postman-cli": "1.60.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.68.0"
  }
}
