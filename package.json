{
  "name": "spellbound-supply-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright Test and TypeScript automation portfolio for Spellbound Supply.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  }
}
